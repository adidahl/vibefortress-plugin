{
  "mcpServers": {
    "vibefortress": {
      "type": "http",
      "url": "https://www.vibefortress.com/mcp"
    },
    "vibefortress-local": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/run.sh"
      ],
      "env": {
        "VIBEFORTRESS_HOME": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
