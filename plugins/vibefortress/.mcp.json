{
  "mcpServers": {
    "vibefortress": {
      "type": "http",
      "url": "https://vibefortress.com/mcp"
    },
    "vibefortress-local": {
      "command": "npx",
      "args": [
        "-y",
        "vibefortress@0.1.50",
        "mcp"
      ],
      "env": {
        "VIBEFORT_HOME": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
